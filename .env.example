# Local configuration. Copy to .env.local and fill in.
# All values are public: they end up in the client bundle. Never put a private key or
# a Hedera account secret here — the page has no backend, holds no key, and signs
# nothing on anyone's behalf.

# mainnet | testnet — the project-wide switch: wallet chain, mirror node and
# explorer links all follow it. Anything else fails loudly at load.
VITE_HEDERA_NETWORK=mainnet

# The only account allowed to create treasuries (layer 3a). Defaults to this id.
VITE_ADMIN_ACCOUNT=0.0.10964435

# Comma-separated treasury account ids — authoritative when set. With an id here the
# page configures that account (change threshold and signers) and never offers a create;
# with the list empty it discovers the admin's accounts and shows the create form.
VITE_TREASURY_ACCOUNTS=

# WalletConnect Cloud project id (public). Copy the value from the open-letter repo's
# local env file; required for the wallet handshake.
VITE_WALLETCONNECT_PROJECT_ID=
