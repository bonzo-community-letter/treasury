# @hashgraph/hedera-wallet-connect lists ethers, @reown/appkit, @reown/walletkit and
# @reown/appkit-controllers as required peers, but this page imports only its dApp entry
# (dist/lib/dapp), which needs none of them. Without this flag npm installs several
# megabytes of code that never reaches the bundle. Same flag as the sibling repos.
legacy-peer-deps=true
